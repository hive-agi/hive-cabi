{:paths ["src" "resources"]

 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        org.clojure/data.json {:mvn/version "2.5.2"}
        metosin/malli {:mvn/version "0.20.2"}
        io.github.hive-agi/hive-addon {:mvn/version "1.1.3"}
        io.github.hive-agi/hive-spi {:mvn/version "1.4.4"}}

 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      org.clojure/test.check {:mvn/version "1.1.3"}
                      io.github.hive-agi/hive-test {:mvn/version "0.4.11"}
                      io.github.hive-agi/hive-schemas {:mvn/version "0.1.40"}}
         :jvm-opts ["--enable-native-access=ALL-UNNAMED" "-Xmx2g"]
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}

  :build {:deps {io.github.hive-agi/hive-build {:mvn/version "0.1.28"}}
          :jvm-opts ["-Xmx1g"]
          :ns-default hive-build.api}}}
